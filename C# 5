using System;

class Program
{
    static void Main()
    {
		Console.Write("valor do item");
		double valorcompra = Convert.ToDouble(Console.ReadLine());
		
		Console.WriteLine("qual o desconto");
		double desconto = Convert.ToDouble(Console.ReadLine());
		
		double valordesconto = valorcompra * desconto / 100;
		double valorfinal = valorcompra - valordesconto;
		
		Console.Write($"O valor do desconto é: {valordesconto:F2}");
		Console.Write($"O valor final é: {valorfinal:F2}");
		

	}
}
